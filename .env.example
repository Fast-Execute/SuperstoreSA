# SuperstoreSA environment
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Admin access
# Comma-separated Supabase Auth email addresses allowed into /admin
SUPABASE_ADMIN_EMAILS=

# Scheduled product sync
# Bearer token required by POST /api/alibaba/sync. The endpoint refuses all requests if this is empty.
# Use the same value as the SYNC_API_KEY secret in the GitHub repository (Settings -> Secrets -> Actions).
SYNC_API_KEY=

# Authorized supplier integration
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
ALIBABA_API_BASE_URL=
ALIBABA_PRODUCT_LIST_PATH=

# Payments
PAYMENT_PROVIDER_SECRET=
